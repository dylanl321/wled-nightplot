NIGHTPLOT_API_URL=http://127.0.0.1:43181
NIGHTPLOT_API_HOST=127.0.0.1
NIGHTPLOT_API_PORT=43181
NIGHTPLOT_STORE_PATH=data/lights.json
NIGHTPLOT_LED_PRODUCTS_PATH=data/led-products.json
NIGHTPLOT_BACKUPS_PATH=data/backups
NIGHTPLOT_DISCOVERY_TARGETS=
# Comma-separated host or host:port. Include the port when it is not 80.
# The local fixture is 127.0.0.1:48210 — Find will not invent that port.
NIGHTPLOT_FIXTURE_PORT=48210
# External-process sim (pnpm sim). Software path only — not Hardware Done.
# NIGHTPLOT_SIM_PORT=48211
# NIGHTPLOT_SIM_DDP_PORT=4048
# 1 = keep /json/info name stale after a /json/cfg rename (metal-shaped). Default off.
# NIGHTPLOT_FIXTURE_INFO_NAME_LAG=1
# WLED bus type for the fixture. 22 = WS281x RGB (default). 30 = SK6812 RGBW.
# NIGHTPLOT_FIXTURE_NATIVE_TYPE=30
# WLED bus colour order. 0 = GRB / GRBW (default). 1 = RGB / RGBW on SK6812.
# NIGHTPLOT_FIXTURE_NATIVE_ORDER=1

# --- pnpm start / containers (defaults stay loopback for `pnpm dev`) ---
# NIGHTPLOT_WEB_HOST=127.0.0.1
# NIGHTPLOT_WEB_PORT=43180
# Compose sets API/web bind to 0.0.0.0. Web→API stays http://127.0.0.1:43181
# (shared network namespace). Do not copy the loopback *bind* into compose.
# Do not env_file this example into compose — loopback bind inside a
# container is unreachable from the published port.
# Extra CORS origins (comma-separated http(s) origins). Defaults stay
# 127.0.0.1 / localhost :43180. `*` is ignored.
# NIGHTPLOT_CORS_ORIGINS=http://192.168.1.10:43180
