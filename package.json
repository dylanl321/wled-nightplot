{
  "name": "nightplot-configure",
  "private": true,
  "version": "0.1.0",
  "description": "Nightplot Configure — the configure spine for Lights and Elements.",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "concurrently -k -n web,api -c \"#d4a574,#7ee0d0\" \"pnpm --filter @nightplot/web dev\" \"pnpm --filter @nightplot/server dev\"",
    "dev:demo": "NIGHTPLOT_DISCOVERY_TARGETS=127.0.0.1:48210 concurrently -k -n web,api,wled -c \"#d4a574,#7ee0d0,#ffa000\" \"pnpm --filter @nightplot/web dev\" \"pnpm --filter @nightplot/server dev\" \"pnpm --filter @nightplot/server fixture\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter @nightplot/web lint",
    "proto": "pnpm dlx serve docs/ui -p 43182",
    "fixture": "pnpm --filter @nightplot/server fixture"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
